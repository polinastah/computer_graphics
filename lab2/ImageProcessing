    static class RangeModel extends SpinnerNumberModel {
        private int min, max, step;

        RangeModel(int min, int max, int step) {
            super(min, min, max, step);
            this.min = min;
            this.max = max;
            this.step = step;
        }

        void updateRange(int min, int max) {
            this.min = min;
            this.max = max;
            int c = cur();
            if (c < min) setValue(min);
            else if (c > max) setValue(max);
            setMinimum(min);
            setMaximum(max);
        }

        private int cur() {
            return getNumber().intValue();
        }

        @Override
        public Object getNextValue() {
            int c = cur();
            if (c >= max) return null;
            return Math.min(max, c + step);
        }

        @Override
        public Object getPreviousValue() {
            int c = cur();
            if (c <= min) return null;
            return Math.max(min, c - step);
        }
    }

    static class JumpSliderUI extends BasicSliderUI {
        JumpSliderUI(JSlider b) {
            super(b);
        }

        @Override
        protected TrackListener createTrackListener(JSlider s) {
            return new TrackListener() {
                @Override
                public void mousePressed(MouseEvent e) {
                    if (!slider.isEnabled() || !SwingUtilities.isLeftMouseButton(e)) return;
                    if (!thumbRect.contains(e.getX(), e.getY())) {
                        slider.setValue(valueForXPosition(e.getX()));
                    }
                    super.mousePressed(e);
                }

                @Override
                public boolean shouldScroll(int direction) {
                    return false;
                }
            };
        }

        @Override
        protected void scrollDueToClickInTrack(int direction) {}
    }

    static class Channel {
        final JSlider slider;
        final JSpinner spinner;
        final JTextField field = new JTextField();
        final RangeModel model;
        int min, max;
        int lastValid;
        boolean programmatic = false;
        Runnable onChange = () -> {};
        Runnable commit;

        Channel(int min, int max, int initial) {
            this.min = min;
            this.max = max;
            this.lastValid = Math.max(min, Math.min(max, initial));

            slider = new JSlider(min, max, lastValid);
            slider.setUI(new JumpSliderUI(slider));
            model = new RangeModel(min, max, 1);
            spinner = new JSpinner(model);

            JPanel editor = new JPanel(new BorderLayout());
            field.setBorder(BorderFactory.createEmptyBorder(1, 4, 1, 4));
            field.setHorizontalAlignment(JTextField.LEFT);
            editor.add(field, BorderLayout.CENTER);
            spinner.setEditor(editor);

            ((AbstractDocument) field.getDocument()).setDocumentFilter(new DocumentFilter() {
                @Override
                public void insertString(FilterBypass fb, int off, String str, AttributeSet a)
                        throws BadLocationException {
                    replace(fb, off, 0, str, a);
                }

                @Override
                public void replace(FilterBypass fb, int off, int len, String text, AttributeSet a)
                        throws BadLocationException {
                    if (programmatic) {
                        super.replace(fb, off, len, text, a);
                        return;
                    }
                    if (text == null) text = "";
                    Document d = fb.getDocument();
                    String cur = d.getText(0, d.getLength());
                    String next = cur.substring(0, off) + text + cur.substring(off + len);
                    if (next.isEmpty() || next.equals("-") || next.matches("-?\\d{0,4}")) {
                        super.replace(fb, off, len, text, a);
                    } else {
                        Toolkit.getDefaultToolkit().beep();
                    }
                }
            });

            commit = () -> {
                if (programmatic) return;
                String text = field.getText().trim();
                int val;
                if (text.isEmpty() || text.equals("-")) {
                    val = Math.max(min, Math.min(max, 0));
                } else {
                    try {
                        val = Integer.parseInt(text);
                    } catch (NumberFormatException ex) {
                        val = lastValid;
                    }
                }
                if (val > max) val = max;
                if (val < min) val = min;
                userSet(val);
            };

            field.addActionListener(e -> commit.run());
            field.addFocusListener(new FocusAdapter() {
                @Override
                public void focusLost(FocusEvent e) {
                    commit.run();
                }
            });

            slider.addChangeListener(e -> {
                if (programmatic) return;
                userSet(slider.getValue());
            });

            spinner.addChangeListener(e -> {
                if (programmatic) return;
                userSet(get());
            });

            set(initial);
        }

        void updateArrows() {
            int v = get();
            for (Component c : spinner.getComponents()) {
                if (!(c instanceof JButton)) continue;
                if ("Spinner.nextButton".equals(c.getName())) c.setEnabled(v < max);
                else if ("Spinner.previousButton".equals(c.getName())) c.setEnabled(v > min);
            }
        }

        int get() {
            Object val = spinner.getValue();
            return val instanceof Number ? ((Number) val).intValue() : lastValid;
        }

        void set(int v) {
            v = Math.max(min, Math.min(max, v));
            lastValid = v;
            programmatic = true;
            try {
                slider.setValue(v);
                field.setText(String.valueOf(v));
                spinner.setValue(v);
                updateArrows();
            } finally {
                programmatic = false;
            }
        }

        void userSet(int v) {
            int prev = lastValid;
            set(v);
            if (prev != lastValid) onChange.run();
        }

        void setRange(int newMin, int newMax, int newVal) {
            this.min = newMin;
            this.max = newMax;
            programmatic = true;
            try {
                slider.setMinimum(newMin);
                slider.setMaximum(newMax);
                model.updateRange(newMin, newMax);
                set(newVal);
            } finally {
                programmatic = false;
            }
        }
    }

