    private void openImage() {
        JFileChooser chooser = new JFileChooser();
        if (chooser.showOpenDialog(this) != JFileChooser.APPROVE_OPTION) return;
        try {
            BufferedImage img = ImageIO.read(chooser.getSelectedFile());
            if (img == null) {
                JOptionPane.showMessageDialog(this, "Не удалось прочитать файл");
                return;
            }
            originalImage = toGray(img);
            processedImage = deepCopy(originalImage);
            resetAllParamsOnly();
            updateImageLabels();
            if (tabs.getSelectedIndex() == 1) {
                applyThresholdAsync();
            }
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Ошибка чтения файла!");
        }
    }

    private void saveImage() {
        if (processedImage == null) return;
        JFileChooser chooser = new JFileChooser();
        if (chooser.showSaveDialog(this) != JFileChooser.APPROVE_OPTION) return;
        try {
            ImageIO.write(processedImage, "png", chooser.getSelectedFile());
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Ошибка сохранения!");
        }
    }

