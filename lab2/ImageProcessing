    private void applyInvert() {
        if (processedImage == null || busy) return;
        BufferedImage src = processedImage;
        int w = src.getWidth(), h = src.getHeight();
        BufferedImage dst = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);
        byte[] srcData = ((DataBufferByte) src.getRaster().getDataBuffer()).getData();
        byte[] dstData = ((DataBufferByte) dst.getRaster().getDataBuffer()).getData();
        for (int i = 0; i < srcData.length; i++) {
            dstData[i] = (byte) (255 - (srcData[i] & 0xFF));
        }
        processedImage = dst;
        updateImageLabels();
    }

    private void applyElementWiseAsync() {
        if (originalImage == null || busy) return;
        busy = true;
        final BufferedImage src = originalImage;
        final int bright = brightnessCh.get();
        final double contrast = contrastCh.get() / 100.0;
        final double gamma = gammaCh.get() / 100.0;

        new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() {
                int w = src.getWidth(), h = src.getHeight();
                BufferedImage dst = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);
                int[] row = new int[w];
                for (int y = 0; y < h; y++) {
                    src.getRGB(0, y, w, 1, row, 0, w);
                    for (int x = 0; x < w; x++) {
                        int g = (row[x] >> 16) & 0xFF;
                        double f = g * contrast + bright;
                        if (f < 0) f = 0; else if (f > 255) f = 255;
                        if (Math.abs(gamma - 1.0) > 1e-6)
                            f = 255.0 * Math.pow(f / 255.0, gamma);
                        int v = (int) Math.max(0, Math.min(255, f));
                        row[x] = (255 << 24) | (v << 16) | (v << 8) | v;
                    }
                    dst.setRGB(0, y, w, 1, row, 0, w);
                }
                return dst;
            }

            @Override
            protected void done() {
                try {
                    processedImage = get();
                    updateImageLabels();
                } catch (Exception ex) {
                    ex.printStackTrace();
                } finally {
                    busy = false;
                }
            }
        }.execute();
    }

    private void applyLinearContrastAsync() {
        if (processedImage == null || busy) return;
        busy = true;
        final BufferedImage src = processedImage;
        new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() {
                int w = src.getWidth(), h = src.getHeight();
                byte[] srcData = ((DataBufferByte) src.getRaster().getDataBuffer()).getData();
                int min = 255, max = 0;
                for (int i = 0; i < srcData.length; i++) {
                    int g = srcData[i] & 0xFF;
                    if (g < min) min = g;
                    if (g > max) max = g;
                }
                BufferedImage dst = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);
                byte[] dstData = ((DataBufferByte) dst.getRaster().getDataBuffer()).getData();
                if (max == min) {
                    System.arraycopy(srcData, 0, dstData, 0, srcData.length);
                    return dst;
                }
                double range = max - min;
                for (int i = 0; i < srcData.length; i++) {
                    int g = srcData[i] & 0xFF;
                    int v = (int) Math.round((g - min) * 255.0 / range);
                    if (v < 0) v = 0; else if (v > 255) v = 255;
                    dstData[i] = (byte) v;
                }
                return dst;
            }

            @Override
            protected void done() {
                try {
                    processedImage = get();
                    updateImageLabels();
                } catch (Exception ex) {
                    ex.printStackTrace();
                } finally {
                    busy = false;
                }
            }
        }.execute();
    }

    private void applyThresholdAsync() {
        if (originalImage == null || busy) return;
        busy = true;
        final BufferedImage src = originalImage;
        final int r = makeOdd(windowCh.get());
        final boolean bernsen = rbBernsen.isSelected();
        final int raw = paramCh.get();

        new SwingWorker<BufferedImage, Void>() {
            @Override
            protected BufferedImage doInBackground() {
                return bernsen ? bernsen(src, r, raw) : niblack(src, r, raw / 100.0);
            }

            @Override
            protected void done() {
                try {
                    processedImage = get();
                    updateImageLabels();
                } catch (Exception ex) {
                    ex.printStackTrace();
                } finally {
                    busy = false;
                }
            }
        }.execute();
    }

    private static int makeOdd(int v) {
        if (v % 2 == 0) v++;
        return Math.max(3, Math.min(31, v));
    }

    private static BufferedImage bernsen(BufferedImage src, int r, double eps) {
        int w = src.getWidth(), h = src.getHeight();
        int off = r / 2;
        BufferedImage dst = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);

        byte[] srcData = ((DataBufferByte) src.getRaster().getDataBuffer()).getData();
        byte[] dstData = ((DataBufferByte) dst.getRaster().getDataBuffer()).getData();

        for (int y = 0; y < h; y++) {
            int yMin = Math.max(0, y - off);
            int yMax = Math.min(h - 1, y + off);

            for (int x = 0; x < w; x++) {
                int xMin = Math.max(0, x - off);
                int xMax = Math.min(w - 1, x + off);

                int min = 255, max = 0;
                for (int yy = yMin; yy <= yMax; yy++) {
                    int rowOff = yy * w;
                    for (int xx = xMin; xx <= xMax; xx++) {
                        int val = srcData[rowOff + xx] & 0xFF;
                        if (val < min) min = val;
                        if (val > max) max = val;
                    }
                }

                int g = srcData[y * w + x] & 0xFF;
                int contrast = max - min;
                int mid = (max + min) / 2;
                int v;

                if (contrast < eps) {
                    v = (mid >= 128) ? 255 : 0;
                } else {
                    v = (g >= mid) ? 255 : 0;
                }

                dstData[y * w + x] = (byte) v;
            }
        }
        return dst;
    }

    private static BufferedImage niblack(BufferedImage src, int r, double k) {
        int w = src.getWidth(), h = src.getHeight();
        int off = r / 2;
        BufferedImage dst = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);

        byte[] srcData = ((DataBufferByte) src.getRaster().getDataBuffer()).getData();
        byte[] dstData = ((DataBufferByte) dst.getRaster().getDataBuffer()).getData();

        double[][] sum = new double[h + 1][w + 1];
        double[][] sumSq = new double[h + 1][w + 1];

        for (int y = 0; y < h; y++) {
            double rowSum = 0;
            double rowSumSq = 0;
            int rowOff = y * w;
            for (int x = 0; x < w; x++) {
                double val = srcData[rowOff + x] & 0xFF;
                rowSum += val;
                rowSumSq += val * val;
                sum[y + 1][x + 1] = sum[y][x + 1] + rowSum;
                sumSq[y + 1][x + 1] = sumSq[y][x + 1] + rowSumSq;
            }
        }

        for (int y = 0; y < h; y++) {
            int y1 = Math.max(0, y - off);
            int y2 = Math.min(h, y + off + 1);

            for (int x = 0; x < w; x++) {
                int x1 = Math.max(0, x - off);
                int x2 = Math.min(w, x + off + 1);

                int count = (x2 - x1) * (y2 - y1);
                double total = sum[y2][x2] - sum[y1][x2] - sum[y2][x1] + sum[y1][x1];
                double totalSq = sumSq[y2][x2] - sumSq[y1][x2] - sumSq[y2][x1] + sumSq[y1][x1];

                double mean = total / count;
                double variance = (totalSq / count) - (mean * mean);
                double std = Math.sqrt(Math.max(0.0, variance));

                double t = mean + k * std;
                int g = srcData[y * w + x] & 0xFF;

                dstData[y * w + x] = (byte) ((g >= t) ? 255 : 0);
            }
        }
        return dst;
    }

    private static BufferedImage toGray(BufferedImage img) {
        BufferedImage g = new BufferedImage(img.getWidth(), img.getHeight(), BufferedImage.TYPE_BYTE_GRAY);
        Graphics2D g2 = g.createGraphics();
        g2.drawImage(img, 0, 0, null);
        g2.dispose();
        return g;
    }

    private static BufferedImage deepCopy(BufferedImage src) {
        BufferedImage b = new BufferedImage(src.getWidth(), src.getHeight(), src.getType());
        Graphics g = b.getGraphics();
        g.drawImage(src, 0, 0, null);
        g.dispose();
        return b;
    }

    private static BufferedImage generateTestImage() {
        int w = 600, h = 400;
        BufferedImage img = new BufferedImage(w, h, BufferedImage.TYPE_BYTE_GRAY);
        Graphics2D g = img.createGraphics();
        g.setPaint(new GradientPaint(0, 0, new Color(40, 40, 40), w, h, new Color(220, 220, 220)));
        g.fillRect(0, 0, w, h);
        g.setColor(new Color(200, 200, 200));
        g.fillOval(60, 60, 160, 160);
        g.setColor(new Color(60, 60, 60));
        g.fillRect(320, 180, 180, 150);
        g.dispose();
        for (int i = 0; i < 4000; i++) {
            int x = (int) (Math.random() * w);
            int y = (int) (Math.random() * h);
            img.setRGB(x, y, Math.random() > 0.5 ? 0xFFFFFFFF : 0xFF000000);
        }
        return img;
    }

    private void updateImageLabels() {
        originalCanvas.setImage(originalImage);
        processedCanvas.setImage(processedImage);
    }

    static class ImageCanvas extends JPanel {
        private static final Color BG = new Color(0xD9, 0xD9, 0xD9);
        private BufferedImage image;

        ImageCanvas() {
            setBackground(BG);
            setOpaque(true);
        }

        void setImage(BufferedImage img) {
            this.image = img;
            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            g.setColor(BG);
            g.fillRect(0, 0, getWidth(), getHeight());
            if (image == null) return;

            int iw = image.getWidth(), ih = image.getHeight();
            double scale = Math.min((double) getWidth() / iw, (double) getHeight() / ih);
            if (scale > 1.0) scale = 1.0;
            int nw = (int) Math.max(1, Math.round(iw * scale));
            int nh = (int) Math.max(1, Math.round(ih * scale));
            int x = (getWidth() - nw) / 2;
            int y = (getHeight() - nh) / 2;

            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_BILINEAR);
            g2.drawImage(image, x, y, nw, nh, null);
            g2.dispose();
        }
    }

